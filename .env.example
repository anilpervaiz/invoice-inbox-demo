# Google AI Studio key for the AI read. Without it, the demo runs the plain-code read only.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Default is gemini-3.8-flash. Change this if the default model is retired.
GEMINI_MODEL=gemini-3.8-flash
# Optional secret token to authenticate full AI health checks on GET /api/health
HEALTH_TOKEN=
# Optional. Default is false in production, true in development. Set to true/false to override.
UPLOADS_ENABLED=
# Optional rate limit overrides
HOURLY_UPLOAD_LIMIT=10
DAILY_UPLOAD_LIMIT=50
